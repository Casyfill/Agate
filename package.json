{
  "name": "agate",
  "version": "0.4.0",
  "description": "Vega and Vega-Lite charts over Obsidian Bases.",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck && tsc -noEmit -skipLibCheck -p test",
    "install:local": "node scripts/install-local.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vega",
    "vega-lite",
    "bases"
  ],
  "author": "Philipp",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "vega-themes": "^3.0.0"
  }
}
