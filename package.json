{
  "name": "agate",
  "version": "0.0.1",
  "description": "Vega and Vega-Lite charts over Obsidian Bases.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "install:local": "node scripts/install-local.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "smoke": "node scripts/smoke-specs.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "vega",
    "vega-lite",
    "bases"
  ],
  "author": "Philipp",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-lite": "^6.4.3",
    "vega-themes": "^3.0.0"
  }
}
