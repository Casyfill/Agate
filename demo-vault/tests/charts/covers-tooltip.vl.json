{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Pages against rating, one point per book. The tooltip shows the book's cover: formula.cover holds an image URL, and a tooltip field titled \"image\" is drawn as a picture by vega-tooltip; one titled \"title\" becomes the heading.",
  "data": { "name": "base" },
  "height": 260,
  "mark": { "type": "point", "filled": true, "size": 140, "opacity": 0.85 },
  "encoding": {
    "x": { "field": "note.pages", "type": "quantitative", "title": "Pages", "scale": { "zero": false } },
    "y": { "field": "note.rating", "type": "quantitative", "title": "Rating", "scale": { "domain": [0, 5] } },
    "color": { "field": "note.genre", "type": "nominal", "title": "Genre" },
    "tooltip": [
      { "field": "file.name", "title": "title" },
      { "field": "formula.cover", "title": "image" },
      { "field": "note.author", "title": "Author" },
      { "field": "note.rating", "title": "Rating" },
      { "field": "note.pages", "title": "Pages" }
    ]
  }
}
