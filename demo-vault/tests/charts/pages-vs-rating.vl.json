{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Interactive without dragging: hovering a point highlights it and shows a tooltip. (Interval brushes work too, but not inside Canvas cards, so the examples avoid them.)",
  "data": { "name": "base" },
  "transform": [{ "filter": "isValid(datum.note.rating) && isValid(datum.note.pages)" }],
  "params": [{ "name": "hover", "select": { "type": "point", "on": "pointerover", "clear": "pointerout", "nearest": true } }],
  "mark": { "type": "point", "filled": true },
  "encoding": {
    "x": { "field": "note.pages", "type": "quantitative", "title": "Pages" },
    "y": {
      "field": "note.rating",
      "type": "quantitative",
      "title": "Rating",
      "scale": { "domain": [0, 5.5] },
      "axis": { "tickMinStep": 1 }
    },
    "color": { "field": "note.genre", "type": "nominal", "title": "Genre" },
    "opacity": { "condition": { "param": "hover", "value": 1, "empty": false }, "value": 0.55 },
    "size": { "condition": { "param": "hover", "value": 220, "empty": false }, "value": 110 },
    "tooltip": [
      { "field": "file.name", "title": "Book" },
      { "field": "note.author", "title": "Author" },
      { "field": "note.pages", "title": "Pages" },
      { "field": "note.rating", "title": "Rating" }
    ]
  },
  "height": 260
}
