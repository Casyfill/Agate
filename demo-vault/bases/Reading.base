filters:
  and:
    - type == "book"
views:
  - type: agate
    name: Reading year
    order: [file.name, author, genre, started, finished, status, rating]
    sort:
      - property: started
        direction: ASC
    specFile: charts/reading-journey.vg.json
  - type: table
    name: Shelf
    order: [file.name, author, genre, pages, started, finished, status, rating]
    sort:
      - property: started
        direction: DESC
