filters:
  or:
    - type == "trip"
    - type == "place"
views:
  - type: agate
    name: Globe
    order: [file.name, purpose, start, end, legs]
    specFile: charts/travel-globe.vg.json
  - type: agate
    name: Countries
    order: [file.name, country]
    specFile: charts/countries-visited.vl.json
  - type: table
    name: Trips
    filters:
      and:
        - type == "trip"
    order: [file.name, purpose, start, nights, companions]
    sort:
      - property: start
        direction: DESC
