{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interview practice: every attempt's cold grade (1–5) over time by domain, a 7-attempt rolling mean, and a ring for each cold re-test from `retestFrom` on. Rows: notes of type interview-attempt with `date`, `domain`, `initial`, `readup`, `final`.",
  "title": "Initial (cold) score over time — line = 7-rep rolling mean, ring = cold re-test",
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "retestFrom",
      "value": "2026-08-09"
    },
    {
      "name": "agateColors",
      "value": {
        "text": "#222",
        "muted": "#777",
        "faint": "#999",
        "background": "#fff",
        "border": "#ccc",
        "accent": "#7c3aed",
        "red": "#e93147",
        "orange": "#ec7500",
        "yellow": "#e0ac00",
        "green": "#08b94e",
        "cyan": "#00bfbc",
        "blue": "#4e79a7",
        "purple": "#7852ee",
        "pink": "#d53984"
      }
    }
  ],
  "transform": [
    {
      "filter": "isValid(datum.note.initial) && datum.note.initial !== ''"
    },
    {
      "calculate": "toDate(datum.note.date)",
      "as": "d"
    },
    {
      "calculate": "indexof(datum.note.domain, 'Coding') >= 0 ? 'Coding' : datum.note.domain",
      "as": "track"
    },
    {
      "window": [
        {
          "op": "mean",
          "field": "note.initial",
          "as": "roll"
        }
      ],
      "sort": [
        {
          "field": "d"
        }
      ],
      "frame": [
        -6,
        0
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "d",
      "type": "temporal",
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 0.75
      },
      "encoding": {
        "y": {
          "field": "note.initial",
          "type": "quantitative",
          "title": "Grade (1–5)",
          "scale": {
            "domain": [
              0.5,
              5.5
            ]
          },
          "axis": {
            "values": [
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "yOffset": {
          "field": "track",
          "type": "nominal"
        },
        "color": {
          "field": "track",
          "type": "nominal",
          "title": "Domain"
        },
        "tooltip": [
          {
            "field": "file.name",
            "title": "Attempt"
          },
          {
            "field": "note.domain",
            "title": "Domain"
          },
          {
            "field": "note.initial",
            "title": "Initial"
          },
          {
            "field": "note.readup",
            "title": "Read-up"
          },
          {
            "field": "note.final",
            "title": "Re-test"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.note.final) && datum.note.final !== '' && datum.d >= toDate(retestFrom)"
        }
      ],
      "mark": {
        "type": "point",
        "size": 140,
        "strokeWidth": 2,
        "color": {
          "expr": "agateColors.blue"
        }
      },
      "encoding": {
        "y": {
          "field": "note.final",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": {
          "expr": "agateColors.muted"
        },
        "strokeWidth": 2,
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "roll",
          "type": "quantitative"
        }
      }
    }
  ]
}