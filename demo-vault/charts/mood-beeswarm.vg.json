{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Beeswarm of daily notes: one dot per day on a timeline, rows by note.mood, colour by energy, size by hours slept. Dots never overlap (force layout). Click a dot to open that day.",
  "usermeta": {
    "agate": {
      "open": "click"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 8,
    "right": 8,
    "top": 8,
    "bottom": 8
  },
  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 720",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 720"
        }
      ]
    },
    {
      "name": "height",
      "value": 340
    },
    {
      "name": "agateDark",
      "value": false,
      "description": "Set by Agate in dark mode."
    }
  ],
  "data": [
    {
      "name": "base"
    },
    {
      "name": "days",
      "source": "base",
      "transform": [
        {
          "type": "formula",
          "as": "t",
          "expr": "toDate(datum.note.date || datum.file.name)"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.t) && isValid(datum.note.mood)"
        },
        {
          "type": "formula",
          "as": "mood",
          "expr": "toNumber(datum.note.mood)"
        },
        {
          "type": "formula",
          "as": "energy",
          "expr": "toNumber(datum.note.energy)"
        },
        {
          "type": "formula",
          "as": "sleep",
          "expr": "toNumber(datum.note.sleep)"
        }
      ]
    },
    {
      "name": "swarm",
      "description": "Separate from days: the x scale reads its domain from days, and the layout reads the x scale.",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "tx",
          "expr": "scale('x', datum.t)"
        },
        {
          "type": "formula",
          "as": "ty",
          "expr": "scale('y', datum.mood)"
        },
        {
          "type": "formula",
          "as": "r",
          "expr": "sqrt(scale('size', datum.sleep || 7)) / 2"
        },
        {
          "type": "force",
          "static": true,
          "iterations": 200,
          "forces": [
            {
              "force": "x",
              "x": "tx",
              "strength": 0.9
            },
            {
              "force": "y",
              "y": "ty",
              "strength": 0.15
            },
            {
              "force": "collide",
              "radius": {
                "expr": "datum.r + 1"
              },
              "iterations": 2
            }
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "time",
      "domain": {
        "data": "days",
        "field": "t"
      },
      "range": "width",
      "nice": "month"
    },
    {
      "name": "y",
      "type": "point",
      "domain": [
        5,
        4,
        3,
        2,
        1
      ],
      "range": [
        20,
        {
          "signal": "height - 30"
        }
      ],
      "padding": 0.5
    },
    {
      "name": "energyColour",
      "type": "linear",
      "domain": [
        1,
        2.33,
        3.67,
        5
      ],
      "range": {
        "signal": "agateDark ? ['#4c2a9e', '#c03fa8', '#ff7ac6', '#ffd166'] : ['#ffe066', '#ff922b', '#e8590c', '#a61e4d']"
      },
      "interpolate": "hcl",
      "zero": false
    },
    {
      "name": "size",
      "type": "linear",
      "domain": [
        4,
        10
      ],
      "range": [
        20,
        160
      ],
      "clamp": true
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "domain": false,
      "grid": true,
      "gridOpacity": 0.12,
      "tickCount": "month"
    },
    {
      "orient": "left",
      "scale": "y",
      "title": "Mood",
      "domain": false,
      "ticks": false,
      "grid": true,
      "gridOpacity": 0.12
    }
  ],
  "legends": [
    {
      "fill": "energyColour",
      "title": "Energy",
      "orient": "top-right",
      "direction": "horizontal",
      "gradientLength": 100
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": {
        "data": "swarm"
      },
      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "size",
            "field": "sleep"
          },
          "fill": {
            "scale": "energyColour",
            "field": "energy"
          },
          "stroke": {
            "signal": "agateDark ? 'rgba(0,0,0,0.55)' : '#ffffff'"
          },
          "strokeWidth": {
            "value": 0.75
          },
          "tooltip": {
            "signal": "{title: timeFormat(datum.t, '%a %b %d'), 'Mood': datum.mood, 'Energy': datum.energy, 'Sleep (h)': datum.sleep, 'Tags': join(datum.note.tags || [], ', ')}"
          },
          "fillOpacity": {
            "value": 0.95
          }
        },
        "hover": {
          "strokeWidth": {
            "value": 2
          }
        }
      }
    }
  ]
}