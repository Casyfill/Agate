{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Projects as bars from start to due, coloured by status; the rule is today. Sort and filter from the Bases toolbar; click a bar to open the project.",
  "usermeta": {
    "agate": {
      "open": "click"
    }
  },
  "data": {
    "name": "base"
  },
  "transform": [
    {
      "filter": "isValid(datum.note.start) && isValid(datum.note.due)"
    }
  ],
  "height": {
    "step": 24
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadius": 2,
        "height": {
          "band": 0.55
        },
        "cursor": "pointer"
      },
      "encoding": {
        "y": {
          "field": "file.name",
          "type": "nominal",
          "sort": null,
          "title": null,
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 12.5,
            "labelPadding": 10,
            "labelFontStyle": "italic",
            "labelLimit": 220
          }
        },
        "x": {
          "field": "note.start",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%b %Y",
            "grid": true,
            "gridOpacity": 0.35,
            "domain": false,
            "ticks": false,
            "orient": "top",
            "labelFontSize": 11
          }
        },
        "x2": {
          "field": "note.due"
        },
        "color": {
          "field": "note.status",
          "type": "nominal",
          "title": "Status",
          "scale": {
            "domain": [
              "active",
              "paused",
              "idea",
              "done"
            ],
            "range": [
              {
                "expr": "agateDark ? '#7fa8d1' : '#1f4e79'"
              },
              {
                "expr": "agateDark ? '#e0b45a' : '#b07d1a'"
              },
              {
                "expr": "agateDark ? '#b591c4' : '#6b3f7a'"
              },
              {
                "expr": "agateDark ? '#6f6a62' : '#b8b2a7'"
              }
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "symbolType": "circle",
            "labelFontSize": 12
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.note.status === 'idea'",
            "value": 0.55
          },
          "value": 1
        },
        "tooltip": [
          {
            "field": "file.name",
            "title": "title"
          },
          {
            "field": "note.area",
            "title": "Area"
          },
          {
            "field": "note.status",
            "title": "Status"
          },
          {
            "field": "note.start",
            "type": "temporal",
            "title": "Start"
          },
          {
            "field": "note.due",
            "type": "temporal",
            "title": "Due"
          },
          {
            "field": "note.priority",
            "title": "Priority"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          3,
          3
        ],
        "color": {
          "expr": "agateDark ? '#e07a85' : '#9b2335'"
        },
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": {
            "expr": "now()"
          },
          "type": "temporal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "text": "today",
        "fontStyle": "italic",
        "fontSize": 11,
        "dx": 4,
        "align": "left",
        "baseline": "top",
        "color": {
          "expr": "agateDark ? '#e07a85' : '#9b2335'"
        },
        "dy": 4
      },
      "encoding": {
        "x": {
          "datum": {
            "expr": "now()"
          },
          "type": "temporal"
        },
        "y": {
          "value": "height"
        }
      }
    }
  ],
  "params": [
    {
      "name": "agateDark",
      "value": false
    }
  ],
  "config": {
    "font": "'Iowan Old Style', Charter, 'Source Serif 4', 'Source Serif Pro', Georgia, serif",
    "view": {
      "stroke": null
    }
  }
}