{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "After Hans Rosling / Gapminder: income per person against life expectancy, one bubble per country, area = population, colour = region. Drag the Year slider to play the decades. Data is the Gapminder five-year panel (1952–2007), a CSV in the vault.",
  "width": 720,
  "height": 480,
  "background": "#fbf7ec",
  "title": {
    "text": "The health and wealth of nations",
    "subtitle": "Income per person vs life expectancy  ·  bubble area = population  ·  after Gapminder / Hans Rosling",
    "anchor": "start",
    "offset": 14,
    "fontSize": 20,
    "subtitleFontSize": 12,
    "subtitleColor": "#6b6258"
  },
  "config": {
    "view": { "stroke": null },
    "font": "'Avenir Next', Avenir, 'Helvetica Neue', Arial, sans-serif",
    "axis": { "domain": false, "ticks": false, "labelColor": "#6b6258", "titleColor": "#4a463e", "grid": true, "gridColor": "#eadfce", "titleFontSize": 12 }
  },
  "params": [
    { "name": "agateDark", "value": false },
    {
      "name": "Year",
      "value": 2007,
      "bind": { "input": "range", "min": 1952, "max": 2007, "step": 5 }
    }
  ],
  "data": {
    "url": "attachments/dataviz/gapminder.csv",
    "format": {
      "type": "csv",
      "parse": { "year": "number", "gdpPercap": "number", "lifeExp": "number", "pop": "number" }
    }
  },
  "transform": [{ "filter": "datum.year === Year" }],
  "layer": [
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "x": 712,
        "y": 472,
        "fontSize": 150,
        "fontWeight": 700,
        "color": "#efe6d6"
      },
      "encoding": { "text": { "field": "year", "aggregate": "max" } }
    },
    {
      "mark": { "type": "circle", "opacity": 0.72, "stroke": "#fbf7ec", "strokeWidth": 0.6, "tooltip": true },
      "encoding": {
        "x": {
          "field": "gdpPercap",
          "type": "quantitative",
          "scale": { "type": "log", "domain": [200, 120000] },
          "title": "Income per person (GDP/capita, $, log scale) →",
          "axis": { "titleAnchor": "start", "titleFontWeight": "normal", "values": [200, 500, 1000, 2000, 5000, 10000, 20000, 50000, 100000], "format": "~s" }
        },
        "y": {
          "field": "lifeExp",
          "type": "quantitative",
          "scale": { "domain": [20, 90] },
          "title": "Life expectancy (years) →",
          "axis": { "titleAnchor": "start", "titleFontWeight": "normal" }
        },
        "size": {
          "field": "pop",
          "type": "quantitative",
          "scale": { "type": "sqrt", "domain": [0, 1400000000], "range": [20, 4200] },
          "legend": null
        },
        "color": {
          "field": "continent",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Africa", "Americas", "Asia", "Europe", "Oceania"],
            "range": ["#4aa3c4", "#6cb16b", "#e0493c", "#e7b63f", "#9d6cb0"]
          },
          "legend": { "orient": "bottom-right", "symbolType": "circle", "symbolSize": 150, "labelFontSize": 12, "fillColor": "#fbf7eccc", "padding": 8, "cornerRadius": 4 }
        },
        "order": { "field": "pop", "sort": "descending" }
      }
    }
  ]
}
