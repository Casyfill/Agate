                          "param": "hoverMap",
                          "empty": false
                        },
                        {
                          "param": "hoverProfile",
                          "empty": false
                        }
                      ]
                    },
                    "value": 1
                  },
                  "value": 0
                }
              }
            },
            {
              "transform": [
                {
                  "calculate": "format(datum['hr'], '.0f') + ' bpm'",
                  "as": "lab"
                }
              ],
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 6,
                "dy": -8,
                "fontSize": 11,
                "fontWeight": "bold"
              },
              "encoding": {
                "x": {
                  "field": "mi",
