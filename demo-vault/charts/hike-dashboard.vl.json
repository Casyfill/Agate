                }
              }
            }
          ]
        }
      ]
    }
  ],
  "params": [
    {
      "name": "agateDark",
      "value": false
    },
    {
      "name": "tz",
      "value": 13
    },
    {
      "name": "basemap",
      "value": "auto",
      "bind": {
        "input": "select",
        "options": [
          "auto",
          "topo",
          "satellite",
          "usgs",
          "hillshade"
        ],
        "labels": [
          "Auto (topo by day, satellite at night)",
          "OpenTopoMap",
