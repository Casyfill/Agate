                        },
                        {
                          "param": "hoverProfile",
                          "empty": false
                        }
                      ]
                    },
                    "value": 1
                  },
                  "value": 0
                }
              }
            },
            {
              "mark": {
                "type": "point",
                "filled": true,
                "size": 50,
                "color": {
                  "expr": "agateDark ? '#ffffff' : '#212529'"
                },
                "stroke": {
                  "expr": "agateDark ? '#000000' : '#ffffff'"
                },
                "strokeWidth": 0.8
              },
              "encoding": {
                "x": {
                  "field": "mi",
                  "type": "quantitative",
                  "scale": {
                    "domain": {
                      "param": "span"
                    }
                  }
                },
                "y": {
                  "field": "hr",
                  "type": "quantitative"
                },
                "opacity": {
                  "condition": {
                    "test": {
                      "or": [
