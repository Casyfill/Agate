{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Cubism-style horizon chart: one strip per note, change since the start of the window, four bands per sign in ColorBrewer Greens/Blues, ramp reversed in dark mode (agateDark). Each note's CSV comes from its formula.csv property (Agate per-row data).",
  "usermeta": {
    "agate": {
      "rowData": { "name": "series", "from": "formula.csv" }
    }
  },
  "autosize": { "type": "fit-x", "contains": "padding" },
  "padding": { "top": 2, "bottom": 2, "left": 0, "right": 0 },

  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 640",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 640"
        }
      ]
    },
    { "name": "agateDark", "value": false, "description": "Set by Agate: true when Obsidian is in dark mode." },
    { "name": "posScheme", "value": "greens" },
    { "name": "negScheme", "value": "blues" },
    {
      "name": "bandT",
      "description": "Where band 0..3 samples the scheme. Light: light to dark, as in cubism. Dark: reversed, so small changes stay near the background.",
      "update": "agateDark ? [0.9, 0.7, 0.5, 0.3] : [0.35, 0.55, 0.75, 0.95]"
    },
    { "name": "rowH", "value": 32 },
    { "name": "bodyH", "description": "Bottom of the last row.", "update": "rowH * max(1, length(data('names')))" },
    { "name": "ftrH", "description": "Room below the rows for the hover date.", "value": 18 },
    { "name": "height", "update": "bodyH + ftrH" },
    {
      "name": "days",
      "value": 365,
      "bind": { "input": "select", "options": [30, 91, 182, 365, 730], "name": "Window (days) " }
    },
    {
      "name": "scaleMode",
      "value": "row",
      "bind": { "input": "radio", "options": ["row", "shared"], "labels": ["per row", "shared"], "name": "Band scale " }
    },
    {
      "name": "hoverT",
      "value": null,
      "on": [
        { "events": "@overlay:mousemove, @overlay:touchmove", "update": "invert('x', clamp(x(), 0, width))" },
        { "events": "@overlay:mouseout, @overlay:touchend", "update": "null" }
      ]
    }
  ],

  "data": [
    { "name": "series" },
    {
      "name": "points",
      "source": "series",
      "transform": [
        { "type": "formula", "as": "name", "expr": "datum.file.name" },
        { "type": "formula", "as": "t", "expr": "toDate(datum.observation_date)" },
        { "type": "formula", "as": "v", "expr": "toNumber(datum[datum.note.fred])" },
        { "type": "filter", "expr": "isValid(datum.t) && isFinite(datum.v) && datum.v > 0" },
        { "type": "joinaggregate", "ops": ["max"], "fields": ["t"], "as": ["tmax"] },
        { "type": "filter", "expr": "datum.t >= datum.tmax - days * 864e5" },
        { "type": "joinaggregate", "groupby": ["name"], "ops": ["argmin"], "fields": ["t"], "as": ["first"] },
        { "type": "formula", "as": "chg", "expr": "datum.v / datum.first.v - 1" },
        { "type": "formula", "as": "mag", "expr": "abs(datum.chg)" },
        { "type": "joinaggregate", "groupby": ["name"], "ops": ["max"], "fields": ["mag"], "as": ["extRow"] },
        { "type": "joinaggregate", "ops": ["max"], "fields": ["mag"], "as": ["extAll"] },
        { "type": "formula", "as": "ext", "expr": "scaleMode === 'shared' ? datum.extAll : datum.extRow" },
        { "type": "formula", "as": "s", "expr": "datum.ext > 0 ? datum.chg / datum.ext * 4 : 0" },
        { "type": "formula", "as": "p0", "expr": "clamp(datum.s, 0, 1)" },
        { "type": "formula", "as": "p1", "expr": "clamp(datum.s - 1, 0, 1)" },
        { "type": "formula", "as": "p2", "expr": "clamp(datum.s - 2, 0, 1)" },
        { "type": "formula", "as": "p3", "expr": "clamp(datum.s - 3, 0, 1)" },
        { "type": "formula", "as": "n0", "expr": "clamp(-datum.s, 0, 1)" },
        { "type": "formula", "as": "n1", "expr": "clamp(-datum.s - 1, 0, 1)" },
        { "type": "formula", "as": "n2", "expr": "clamp(-datum.s - 2, 0, 1)" },
        { "type": "formula", "as": "n3", "expr": "clamp(-datum.s - 3, 0, 1)" }
      ]
    },
    {
      "name": "bands",
      "source": "points",
      "transform": [
        { "type": "project", "fields": ["name", "t", "p0", "n0", "p1", "n1", "p2", "n2", "p3", "n3"] },
        { "type": "fold", "fields": ["p0", "n0", "p1", "n1", "p2", "n2", "p3", "n3"], "as": ["key", "h"] },
        { "type": "formula", "as": "b", "expr": "toNumber(substring(datum.key, 1))" },
        { "type": "formula", "as": "neg", "expr": "indexof(datum.key, 'n') === 0" }
      ]
    },
    {
      "name": "names",
      "source": "base",
      "transform": [
        { "type": "window", "ops": ["row_number"], "as": ["order"] },
        { "type": "formula", "as": "name", "expr": "datum.file.name" }
      ]
    },
    {
      "name": "current",
      "source": "points",
      "transform": [
        { "type": "filter", "expr": "hoverT === null || datum.t <= hoverT" },
        { "type": "aggregate", "groupby": ["name"], "ops": ["argmax"], "fields": ["t"], "as": ["cur"] }
      ]
    }
  ],

  "scales": [
    { "name": "x", "type": "utc", "domain": { "data": "points", "field": "t" }, "range": "width" },
    {
      "name": "rows",
      "type": "band",
      "domain": { "data": "names", "field": "name", "sort": { "field": "order", "op": "min" } },
      "range": [0, { "signal": "bodyH" }]
    },
    { "name": "pos", "type": "linear", "domain": [0, 1], "range": { "scheme": { "signal": "posScheme" } } },
    { "name": "neg", "type": "linear", "domain": [0, 1], "range": { "scheme": { "signal": "negScheme" } } }
  ],

  "axes": [
    { "orient": "top", "scale": "x", "labelFlush": 40, "labelOverlap": true, "labelBound": true, "domain": false, "tickCount": { "signal": "ceil(width / 110)" }, "zindex": 1 }
  ],

  "marks": [
    {
      "type": "group",
      "name": "strip",
      "from": { "facet": { "name": "stripData", "data": "bands", "groupby": ["name"] } },
      "encode": {
        "update": {
          "x": { "value": 0 },
          "width": { "signal": "width" },
          "y": { "scale": "rows", "field": "name" },
          "height": { "signal": "rowH - 1" },
          "clip": { "value": true }
        }
      },
      "marks": [
        {
          "type": "group",
          "from": { "facet": { "name": "bandData", "data": "stripData", "groupby": ["key", "b", "neg"] } },
          "sort": { "field": "datum.b" },
          "marks": [
            {
              "type": "area",
              "from": { "data": "bandData" },
              "interactive": false,
              "sort": { "field": "datum.t" },
              "encode": {
                "update": {
                  "x": { "scale": "x", "field": "t" },
                  "y": { "signal": "datum.neg ? 0 : (rowH - 1) * (1 - datum.h)" },
                  "y2": { "signal": "datum.neg ? (rowH - 1) * datum.h : rowH - 1" },
                  "fill": { "signal": "datum.neg ? scale('neg', bandT[datum.b]) : scale('pos', bandT[datum.b])" },
                  "interpolate": { "value": "linear" }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "text",
      "style": "text",
      "from": { "data": "names" },
      "interactive": false,
      "encode": {
        "update": {
          "x": { "value": 6 },
          "y": { "scale": "rows", "field": "name", "offset": { "signal": "rowH / 2" } },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 11 },
          "text": { "field": "name" }
        }
      }
    },
    {
      "type": "text",
      "style": "text",
      "from": { "data": "current" },
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "width - 6" },
          "y": { "scale": "rows", "field": "name", "offset": { "signal": "rowH / 2" } },
          "align": { "value": "right" },
          "baseline": { "value": "middle" },
          "fontSize": { "value": 11 },
          "text": {
            "signal": "format(datum.cur.v, datum.cur.v >= 1000 ? ',.0f' : ',.2f') + '  ' + format(datum.cur.chg, '+.1%')"
          }
        }
      }
    },
    {
      "type": "rect",
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "hoverT === null ? 0 : scale('x', hoverT)" },
          "width": { "value": 1 },
          "y": { "value": 0 },
          "y2": { "signal": "bodyH" },
          "opacity": { "signal": "hoverT === null ? 0 : 1" }
        }
      }
    },
    {
      "type": "text",
      "style": "guide-label",
      "interactive": false,
      "encode": {
        "update": {
          "x": { "signal": "hoverT === null ? 0 : clamp(scale('x', hoverT), 40, width - 40)" },
          "y": { "signal": "bodyH + 4" },
          "align": { "value": "center" },
          "baseline": { "value": "top" },
          "text": { "signal": "hoverT === null ? '' : utcFormat(hoverT, '%b %d, %Y')" },
          "fontWeight": { "value": "bold" }
        }
      }
    },
    {
      "type": "rect",
      "name": "overlay",
      "encode": {
        "update": {
          "x": { "value": 0 },
          "x2": { "signal": "width" },
          "y": { "value": 0 },
          "y2": { "signal": "bodyH" },
          "fill": { "value": "transparent" }
        }
      }
    }
  ]
}
