{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Interactive: drag an interval brush to highlight books; hover for tooltips.",
  "data": { "name": "base" },
  "transform": [{ "filter": "isValid(datum.note.rating) && isValid(datum.note.pages)" }],
  "params": [{ "name": "brush", "select": { "type": "interval" } }],
  "mark": { "type": "point", "filled": true, "size": 110, "opacity": 0.85 },
  "encoding": {
    "x": { "field": "note.pages", "type": "quantitative", "title": "Pages" },
    "y": {
      "field": "note.rating",
      "type": "quantitative",
      "title": "Rating",
      "scale": { "domain": [0, 5.5] },
      "axis": { "tickMinStep": 1 }
    },
    "color": {
      "condition": { "param": "brush", "field": "note.genre", "type": "nominal", "title": "Genre" },
      "value": "#9e9e9e"
    },
    "tooltip": [
      { "field": "file.name", "title": "Book" },
      { "field": "note.author", "title": "Author" },
      { "field": "note.pages", "title": "Pages" },
      { "field": "note.rating", "title": "Rating" }
    ]
  },
  "height": 260
}
